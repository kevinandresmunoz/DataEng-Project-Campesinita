{
  "dashboard_title": "Dashboard Operacional de Inventario",
  "description": "Monitoreo de stock, alertas críticas y gestión de inventario por sucursal",
  "published": true,
  "charts": [
    {
      "slice_name": "Valor Total de Inventario",
      "viz_type": "big_number_total",
      "datasource": "gold.fact_kpis_inventario",
      "query_context": {
        "metrics": [
          "SUM(valor_total_inventario)"
        ]
      },
      "description": "Valor total del inventario en todas las sucursales"
    },
    {
      "slice_name": "Items Críticos",
      "viz_type": "big_number_total",
      "datasource": "gold.fact_kpis_inventario",
      "query_context": {
        "metrics": [
          "SUM(items_criticos)"
        ]
      },
      "description": "Número de items en estado crítico que requieren acción inmediata",
      "color": "red"
    },
    {
      "slice_name": "Items en Alerta",
      "viz_type": "big_number_total",
      "datasource": "gold.fact_kpis_inventario",
      "query_context": {
        "metrics": [
          "SUM(items_alerta)"
        ]
      },
      "description": "Número de items en estado de alerta",
      "color": "orange"
    },
    {
      "slice_name": "Items a Reabastecer",
      "viz_type": "big_number_total",
      "datasource": "gold.fact_kpis_inventario",
      "query_context": {
        "metrics": [
          "SUM(items_sin_stock) + SUM(items_stock_bajo)"
        ]
      },
      "description": "Número de items sin stock o con stock bajo que requieren reabastecimiento",
      "color": "blue"
    },
    {
      "slice_name": "Alertas por Prioridad",
      "viz_type": "pie",
      "datasource": "gold.fact_alertas_inventario",
      "query_context": {
        "metrics": [
          "COUNT(inventario_id)"
        ],
        "groupby": [
          "prioridad"
        ]
      },
      "description": "Distribución de alertas por nivel de prioridad (Alta, Media, Baja)"
    },
    {
      "slice_name": "Acciones Recomendadas",
      "viz_type": "bar",
      "datasource": "gold.fact_alertas_inventario",
      "query_context": {
        "metrics": [
          "COUNT(inventario_id)"
        ],
        "groupby": [
          "accion_recomendada"
        ],
        "order_desc": true
      },
      "description": "Distribución de acciones recomendadas (Liquidar urgente, Promocionar, Reabastecer, Monitorear)"
    },
    {
      "slice_name": "Stock Total por Sucursal",
      "viz_type": "bar",
      "datasource": "gold.fact_kpis_inventario",
      "query_context": {
        "metrics": [
          "SUM(stock_total)"
        ],
        "groupby": [
          "sucursal_key"
        ],
        "order_desc": true
      },
      "description": "Cantidad total de unidades en stock por sucursal"
    },
    {
      "slice_name": "Valor de Inventario por Sucursal",
      "viz_type": "bar",
      "datasource": "gold.fact_kpis_inventario",
      "query_context": {
        "metrics": [
          "SUM(valor_total_inventario)"
        ],
        "groupby": [
          "sucursal_key"
        ],
        "order_desc": true
      },
      "description": "Valor monetario del inventario por sucursal"
    },
    {
      "slice_name": "Items Críticos por Sucursal",
      "viz_type": "heatmap",
      "datasource": "gold.fact_kpis_inventario",
      "query_context": {
        "metrics": [
          "SUM(items_criticos)"
        ],
        "groupby": [
          "sucursal_key"
        ]
      },
      "description": "Mapa de calor de items críticos por sucursal"
    },
    {
      "slice_name": "Top 30 Productos Críticos",
      "viz_type": "table",
      "datasource": "gold.fact_alertas_inventario",
      "query_context": {
        "metrics": [
          "MIN(dias_hasta_caducidad)",
          "SUM(cantidad)",
          "SUM(valor_inventario)"
        ],
        "groupby": [
          "producto_key",
          "sucursal_key",
          "estado_caducidad",
          "accion_recomendada"
        ],
        "filters": [
          {
            "col": "prioridad",
            "op": "IN",
            "val": [
              "Alta",
              "Media"
            ]
          }
        ],
        "order_desc": true,
        "row_limit": 30
      },
      "description": "Productos que requieren acción inmediata con detalles de caducidad y valor"
    },
    {
      "slice_name": "Distribución de Estado de Caducidad",
      "viz_type": "pie",
      "datasource": "gold.fact_inventario",
      "query_context": {
        "metrics": [
          "COUNT(inventario_id)"
        ],
        "groupby": [
          "estado_caducidad"
        ]
      },
      "description": "Distribución de items por estado de caducidad (Crítico, Alerta, Normal, Óptimo)"
    },
    {
      "slice_name": "Días Promedio hasta Caducidad",
      "viz_type": "bar",
      "datasource": "gold.fact_kpis_inventario",
      "query_context": {
        "metrics": [
          "AVG(dias_promedio_caducidad)"
        ],
        "groupby": [
          "sucursal_key"
        ],
        "order_desc": false
      },
      "description": "Promedio de días hasta caducidad por sucursal"
    },
    {
      "slice_name": "Valor Venta Potencial vs Valor Inventario",
      "viz_type": "bar",
      "datasource": "gold.fact_kpis_inventario",
      "query_context": {
        "metrics": [
          "SUM(valor_total_inventario)",
          "SUM(valor_venta_potencial_total)"
        ],
        "groupby": [
          "sucursal_key"
        ]
      },
      "description": "Comparativa entre valor de costo y valor de venta potencial por sucursal"
    },
    {
      "slice_name": "Items Únicos por Sucursal",
      "viz_type": "bar",
      "datasource": "gold.fact_kpis_inventario",
      "query_context": {
        "metrics": [
          "SUM(items_unicos)"
        ],
        "groupby": [
          "sucursal_key"
        ],
        "order_desc": true
      },
      "description": "Variedad de productos (SKUs únicos) por sucursal"
    },
    {
      "slice_name": "Timeline de Alertas Críticas",
      "viz_type": "line",
      "datasource": "gold.fact_alertas_inventario",
      "query_context": {
        "metrics": [
          "COUNT(inventario_id)"
        ],
        "groupby": [
          "fecha_alerta"
        ],
        "filters": [
          {
            "col": "prioridad",
            "op": "==",
            "val": "Alta"
          }
        ],
        "time_range": "Last 30 days"
      },
      "description": "Evolución temporal de alertas críticas en los últimos 30 días"
    }
  ],
  "filters": [
    {
      "column": "sucursal_key",
      "operator": "IN",
      "value": []
    },
    {
      "column": "prioridad",
      "operator": "IN",
      "value": [
        "Alta",
        "Media",
        "Baja"
      ]
    },
    {
      "column": "estado_caducidad",
      "operator": "IN",
      "value": [
        "Crítico",
        "Alerta",
        "Normal",
        "Óptimo"
      ]
    }
  ],
  "metadata": {
    "refresh_frequency": "Every 6 hours",
    "color_scheme": "supersetColors",
    "default_filters": {
      "prioridad": [
        "Alta",
        "Media"
      ]
    },
    "alert_thresholds": {
      "items_criticos": 50,
      "items_alerta": 100
    }
  },
