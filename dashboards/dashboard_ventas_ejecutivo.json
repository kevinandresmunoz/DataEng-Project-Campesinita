{
  "dashboard_title": "Dashboard Ejecutivo de Ventas",
  "description": "Vista ejecutiva de ventas, rentabilidad y performance por sucursal",
  "published": true,
  "charts": [
    {
      "slice_name": "Ventas Totales por Mes",
      "viz_type": "line",
      "datasource": "gold.fact_kpis_diarios",
      "query_context": {
        "metrics": ["SUM(ventas_totales)"],
        "groupby": ["fecha_key"],
        "time_range": "Last year",
        "granularity": "month"
      },
      "description": "Tendencia de ventas mensuales con comparativa año anterior"
    },
    {
      "slice_name": "Top 10 Sucursales por Ventas",
      "viz_type": "bar",
      "datasource": "gold.fact_kpis_diarios",
      "query_context": {
        "metrics": ["SUM(ventas_totales)"],
        "groupby": ["sucursal_key"],
        "order_desc": true,
        "row_limit": 10
      },
      "description": "Ranking de sucursales por volumen de ventas"
    },
    {
      "slice_name": "Margen Bruto Total",
      "viz_type": "big_number_total",
      "datasource": "gold.fact_kpis_diarios",
      "query_context": {
        "metrics": ["SUM(margen_bruto_total)"]
      },
      "description": "Margen bruto acumulado del período"
    },
    {
      "slice_name": "Ticket Promedio",
      "viz_type": "big_number",
      "datasource": "gold.fact_kpis_diarios",
      "query_context": {
        "metrics": ["AVG(ticket_promedio)"]
      },
      "description": "Ticket promedio de compra"
    },
    {
      "slice_name": "Número de Transacciones",
      "viz_type": "big_number_total",
      "datasource": "gold.fact_kpis_diarios",
      "query_context": {
        "metrics": ["SUM(numero_transacciones)"]
      },
      "description": "Total de transacciones realizadas"
    },
    {
      "slice_name": "Ventas por Período del Día",
      "viz_type": "pie",
      "datasource": "gold.fact_ventas",
      "query_context": {
        "metrics": ["SUM(total)"],
        "groupby": ["periodo_dia"]
      },
      "description": "Distribución de ventas por Mañana, Tarde y Noche"
    },
    {
      "slice_name": "Clientes Únicos por Día",
      "viz_type": "line",
      "datasource": "gold.fact_kpis_diarios",
      "query_context": {
        "metrics": ["SUM(clientes_unicos)"],
        "groupby": ["fecha_key"],
        "time_range": "Last 30 days"
      },
      "description": "Evolución de clientes únicos diarios"
    },
    {
      "slice_name": "Ventas Fin de Semana vs Entre Semana",
      "viz_type": "bar",
      "datasource": "gold.fact_ventas",
      "query_context": {
        "metrics": ["SUM(total)", "COUNT(venta_id)"],
        "groupby": ["es_fin_semana"]
      },
      "description": "Comparativa de ventas entre días laborales y fin de semana"
    },
    {
      "slice_name": "Top 20 Productos por Ingresos",
      "viz_type": "table",
      "datasource": "gold.fact_rendimiento_productos",
      "query_context": {
        "metrics": ["SUM(ingresos_totales)", "SUM(unidades_vendidas)", "SUM(margen_total)"],
        "groupby": ["producto_id"],
        "order_desc": true,
        "row_limit": 20
      },
      "description": "Productos más rentables con métricas de performance"
    },
    {
      "slice_name": "Segmentación RFM de Clientes",
      "viz_type": "pie",
      "datasource": "gold.fact_analisis_clientes",
      "query_context": {
        "metrics": ["COUNT(cliente_key)"],
        "groupby": ["segmento_rfm"]
      },
      "description": "Distribución de clientes por segmento (Champions, Leales, Potenciales, En Riesgo, Regulares)"
    },
    {
      "slice_name": "Heatmap Ventas por Hora y Día",
      "viz_type": "heatmap",
      "datasource": "gold.fact_ventas",
      "query_context": {
        "metrics": ["SUM(total)"],
        "groupby": ["hora", "dia_semana"]
      },
      "description": "Patrón de ventas por hora del día y día de la semana"
    },
    {
      "slice_name": "Margen Bruto por Sucursal",
      "viz_type": "bar",
      "datasource": "gold.fact_kpis_diarios",
      "query_context": {
        "metrics": ["SUM(margen_bruto_total)"],
        "groupby": ["sucursal_key"],
        "order_desc": true
      },
      "description": "Margen bruto total por sucursal"
    }
  ],
  "filters": [
    {
      "column": "fecha_key",
      "operator": "TEMPORAL_RANGE",
      "value": "Last year"
    },
    {
      "column": "sucursal_key",
      "operator": "IN",
      "value": []
    }
  ],
  "metadata": {
    "refresh_frequency": "Daily",
    "color_scheme": "supersetColors",
    "default_filters": {
      "fecha_key": "Last 30 days"
    }
  },
  "position_json": {
    "CHART-1": {"col": 0, "row": 0, "size_x": 4, "size_y": 4},
    "CHART-2": {"col": 4, "row": 0, "size_x": 4, "size_y": 4},
    "CHART-3": {"col": 8, "row": 0, "size_x": 2, "size_y": 2},
    "CHART-4": {"col": 10, "row": 0, "size_x": 2, "size_y": 2},
    "CHART-5": {"col": 8, "row": 2, "size_x": 4, "size_y": 2},
    "CHART-6": {"col": 0, "row": 4, "size_x": 3, "size_y": 4},
    "CHART-7": {"col": 3, "row": 4, "size_x": 5, "size_y": 4},
    "CHART-8": {"col": 8, "row": 4, "size_x": 4, "size_y": 4},
    "CHART-9": {"col": 0, "row": 8, "size_x": 6, "size_y": 5},
    "CHART-10": {"col": 6, "row": 8, "size_x": 3, "size_y": 5},
    "CHART-11": {"col": 9, "row": 8, "size_x": 3, "size_y": 5},
    "CHART-12": {"col": 0, "row": 13, "size_x": 12, "size_y": 4}
  }
}
